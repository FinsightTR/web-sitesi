# Contact form delivery target
CONTACT_TO_EMAIL=yasin@fincity.com.tr

# Optional provider configuration. Do not commit real secrets.
CONTACT_PROVIDER=resend
CONTACT_FROM_EMAIL=noreply@fincity.com.tr
RESEND_API_KEY=
SENDGRID_API_KEY=

# Future auth placeholders only; do not point to production without explicit approval.
NEXT_PUBLIC_AUTH_PROVIDER=placeholder
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Workspace authorization foundation.
# Real values must be defined in Vercel Environment Variables, not committed to GitHub.
# SUPABASE_SERVICE_ROLE_KEY is reserved for future server-side admin workflows and is not used in this phase.
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_MALI_MUSAVIRLIK_URL=
